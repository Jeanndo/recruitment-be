# Copy this file to `.env` and fill in real local values.

# PostgreSQL connection string.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/brightcore

# Secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Account created by `python -m backend.seed`.
ADMIN_EMAIL=admin@brightcore.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FULL_NAME=BrightCore Admin

CORS_ORIGINS=http://localhost:3000

# Set to true when the API is served over HTTPS.
COOKIE_SECURE=false

# Gmail account used to send application confirmation emails.
# https://myaccount.google.com/apppasswords
EMAIL_SENDER=you@gmail.com
EMAIL_SENDER_PASS=CHANGE_ME
